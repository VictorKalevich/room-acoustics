{
  "name": "room-acoustics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:v2": "vite --config vite.v2.config.ts",
    "build:v2": "tsc --noEmit && vite build --config vite.v2.config.ts",
    "preview:v2": "vite preview --config vite.v2.config.ts",
    "e2e:v2": "playwright test --config playwright.v2.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run fixtures && playwright test --project=iphone",
    "e2e:safari": "npm run fixtures && playwright test --project=iphone-safari",
    "fixtures": "vite-node scripts/make-fixtures.ts",
    "lint": "npm run design:check && oxlint -c .oxlintrc.json --deny-warnings src tests scripts",
    "design:check": "node scripts/check-design-system.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "fake-indexeddb": "^6.2.4",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "yaml": "^2.8.1"
  }
}
