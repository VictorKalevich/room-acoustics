{
  "name": "room-acoustics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run fixtures && playwright test --project=iphone",
    "e2e:safari": "npm run fixtures && playwright test --project=iphone-safari",
    "fixtures": "vite-node scripts/make-fixtures.ts",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src tests scripts"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "yaml": "^2.8.1"
  }
}
